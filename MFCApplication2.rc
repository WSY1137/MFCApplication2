//
// Icon
//

// ID value associated with the large icon, ensure correct icon is used
// Only one icon in the system
IDR_MAINFRAME           ICON         "res\\MFCApplication2.ico"


#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
LANGUAGE 4, 2

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About MFCApplication2"

BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "MFCApplication2 Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2025",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_MFCAPPLICATION2_DIALOG DIALOGEX  0, 0, 500, 600
STYLE DS_SHELLFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "AGV Path Planning System"

BEGIN
    LTEXT           "Rows:",IDC_STATIC,10,10,30,12
    EDITTEXT        IDC_EDIT_ROWS,45,10,50,14,ES_AUTOHSCROLL
    LTEXT           "Cols:",IDC_STATIC,105,10,30,12
    EDITTEXT        IDC_EDIT_COLS,140,10,50,14,ES_AUTOHSCROLL
    LTEXT           "Speed(ms/step):",IDC_STATIC,10,35,80,12
    EDITTEXT        IDC_EDIT_SPEED,85,35,50,14,ES_AUTOHSCROLL
    LTEXT           "TurnTime(ms):",IDC_STATIC,140,35,80,12
    EDITTEXT        IDC_EDIT_TURNTIME,225,35,50,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Generate",IDC_BUTTON_GENERATE,10,60,70,20
    PUSHBUTTON      "Start",IDC_BUTTON_START,90,60,70,20
    PUSHBUTTON      "Stop",IDC_BUTTON_STOP,170,60,70,20
    PUSHBUTTON      "Exit",IDCANCEL,250,60,70,20
END

